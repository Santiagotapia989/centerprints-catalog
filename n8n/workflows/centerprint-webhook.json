{
  "name": "Centerprint - Contacto Web",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contacto",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "8e4a6b4d-1c2f-4a5e-9b3a-c7d49f2e1b00",
      "name": "Webhook Contacto",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "8e4a6b4d-1c2f-4a5e-9b3a-c7d49f2e1b00"
    },
    {
      "parameters": {
        "jsCode": "const { json } = $input.first();\nconst fecha = new Date().toISOString();\nconst asunto = `Nueva ${json.tipo || 'Consulta'} web - ${json.producto || 'sin producto'}`;\nconst cuerpo = `\n<b>Nombre:</b> ${json.nombre || '-'}<br/>\n<b>Empresa:</b> ${json.empresa || '-'}<br/>\n<b>Email:</b> ${json.email || '-'}<br/>\n<b>Telefono:</b> ${json.telefono || '-'}<br/>\n<b>Producto de interes:</b> ${json.producto || '-'}<br/>\n<b>Tipo de consulta:</b> ${json.tipo || 'Consulta'}<br/>\n<b>Mensaje:</b> ${json.mensaje || '-'}<br/>\n<b>Origen:</b> ${json.origen || 'sitio-web'}<br/>\n<b>Fecha:</b> ${fecha}\n`;\nreturn [{ json: {\n  nombre: json.nombre || '',\n  empresa: json.empresa || '',\n  email: json.email || '',\n  telefono: json.telefono || '',\n  producto: json.producto || '',\n  tipo: json.tipo || 'Consulta',\n  mensaje: json.mensaje || '',\n  origen: json.origen || 'sitio-web',\n  fecha,\n  asunto,\n  cuerpo\n} }];"
      },
      "id": "7b8c9f2d-44aa-4b81-9f2c-6d22a5e9a001",
      "name": "Formatear datos del cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fromEmail": "centerprint@ciudad.com.ar",
        "toEmail": "={{ $json.email }}",
        "emailFormat": "html",
        "subject": "={{ $json.asunto }}",
        "text": "={{ $json.cuerpo }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "CUSTOM",
          "name": "SMTP"
        }
      },
      "id": "5d3e7f1a-2b8d-4c54-a671-9e0bf3c8d103",
      "name": "Notificar por Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [440, -90]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "contactos",
        "columns": "nombre,empresa,email,telefono,producto,tipo,mensaje,origen,fecha",
        "values": "={{ $json.nombre }}, {{ $json.empresa }}, {{ $json.email }}, {{ $json.telefono }}, {{ $json.producto }}, {{ $json.tipo }}, {{ $json.mensaje }}, {{ $json.origen }}, {{ $json.fecha }}",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "CUSTOM",
          "name": "Postgres"
        }
      },
      "id": "9a1c2e5b-3d4f-40ae-b8c2-7f0a9d4e6b05",
      "name": "Registrar en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [440, 90]
    }
  ],
  "connections": {
    "Webhook Contacto": {
      "main": [
        [
          {
            "node": "Formatear datos del cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear datos del cliente": {
      "main": [
        [
          {
            "node": "Notificar por Email",
            "type": "main",
